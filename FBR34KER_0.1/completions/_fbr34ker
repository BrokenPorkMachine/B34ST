#compdef fbr34ker

_fbr34ker() {
  local -a commands
  commands=(
    'version:print the release version'
    'doctor:check host prerequisites'
    'build:build monitor, SDK, loader, modules, and Apple boot bundles'
    'test:run the bounded validation gate'
    'run:boot a QEMU profile'
    'clean:remove generated outputs'
    'package:create deterministic release archives'
    'gate:run the release gate'
    'permissions:restore executable modes'
    'deploy:run the authorized deployment client'
    'recover:reset a deployment session'
    'inspect:inspect deployment state or artifacts'
    'evidence:export deployment evidence'
    'boot-image:build or inspect FBRI boot images'
    'irecovery:query, verify, or send through an authorized recovery session'
    'device:list, watch, or diagnose authorized recovery devices'
    'bridge:run the reference persistent first-stage bridge'
    'session:inspect or replay physical-integration evidence'
    'crash:decode a recorded crash report'
    'trace:render a recorded trace timeline'
    'bringup:run, collect, or recover a first-stage session'
    'hardware:prepare, validate, diagnose, or explain physical-validation sessions'
    'physical-validation:validate evidence, generate candidate reports, or promote profiles'
    'evidence-compare:compare bring-up evidence bundles'
    'module:invoke the module utility'
    'new-board:create a board-port scaffold'
    'new-driver:create a driver scaffold'
    'new-module:create a module scaffold'
    'new-transport:create a transport-adapter scaffold'
    'abi-check:verify public ABI compatibility'
    'verify-release:verify manifest, hashes, and optional signature'
    'compare-releases:compare deterministic archives'
  )
  _arguments -C \
    '--json[emit stable JSON output]' \
    '1:command:->command' \
    '*::arguments:->args'
  case $state in
    command) _describe 'command' commands ;;
    args)
      case $words[2] in
        run) _values 'profile' direct generic probe ;;
        *) _files ;;
      esac
      ;;
  esac
}
_fbr34ker "$@"
