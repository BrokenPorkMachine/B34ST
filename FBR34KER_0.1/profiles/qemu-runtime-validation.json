{
  "schema_version": 1,
  "name": "qemu-virt-runtime-validation",
  "machine": {
    "binary": "qemu-system-aarch64",
    "machine": "virt,gic-version=3",
    "cpu": "cortex-a72",
    "memory_mib": 256,
    "serial": "stdio",
    "monitor": "none",
    "no_reboot": true
  },
  "image": "build-integration/fbr34ker-test.bin",
  "required_capabilities": [
    "trace",
    "event-bus",
    "service-registry",
    "driver-manager",
    "platform-catalog"
  ],
  "validation_sequence": [
    "architecture",
    "trace-json",
    "fault-status",
    "fault-arm component-start 0 1 platform-catalog",
    "architecture-restart",
    "fault-status",
    "architecture-restart",
    "architecture",
    "drivers"
  ],
  "expected_outcome": "rollback-then-recovery"
}
