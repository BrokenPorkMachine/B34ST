{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fbr34ker.invalid/schemas/bridge-protocol-v1.json",
  "title": "FBR34KER persistent first-stage bridge protocol v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "sequence", "operation", "arguments"],
      "properties": {
        "schema_version": {"const": 1},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 4096},
        "operation": {"type": "string", "minLength": 1, "maxLength": 64},
        "arguments": {"type": "object"}
      }
    },
    {
      "type": "object",
      "required": ["schema_version", "sequence", "ok"],
      "properties": {
        "schema_version": {"const": 1},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 4096},
        "ok": {"type": "boolean"},
        "result": {"type": "object"},
        "error": {"type": "string", "maxLength": 4096}
      }
    }
  ]
}
