{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fbr34ker.invalid/schemas/physical-integration-session-v1.json",
  "title": "FBR34KER physical integration evidence session v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "project", "release_version", "session_id", "profile_id", "device", "adapter", "image", "stages", "passed"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"const": "FBR34KER"},
    "release_version": {"type": "string"},
    "session_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "profile_id": {"type": "string"},
    "device": {"type": "object"},
    "adapter": {"type": "object"},
    "image": {"type": "object"},
    "stages": {"type": "array"},
    "passed": {"type": "boolean"},
    "physical_execution_verified": {"type": "boolean"}
  }
}
