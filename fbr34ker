VERSION_RE = re.compile(r'^#define FBR34KER_MONITOR_VERSION "([^"]+)"$', re.M)
VERSION = VERSION_RE.search((ROOT / "include/fbr34ker/version.h").read_text()).group(1)


class CliError(RuntimeError):
    def __init__(self, message, code=1):
        super().__init__(message)
        self.code = code


class Colors:
    if os.isatty(1):
        BOLD = "\033[1m"
        DIM = "\033[2m"
        RED = "\033[31m"
        GREEN = "\033[32m"
        YELLOW = "\033[33m"
        BLUE = "\033[34m"
        CYAN = "\033[36m"
        RESET = "\033[0m"
        CLEAR = "\033[2J\033[H"
    else:
        BOLD = DIM = RED = GREEN = YELLOW = BLUE = CYAN = RESET = CLEAR = ""


def eprint(*args, **kwargs):
    print(*args, file=sys.stderr, **kwargs)


def run(cmd, *, capture=False, timeout=120, cwd=ROOT, check=True, env=None):
    kwargs = dict(cwd=cwd, timeout=timeout)
    if capture:
        kwargs.update(stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if env is not None:
        kwargs["env"] = env
    proc = subprocess.run([str(x) for x in cmd], **kwargs)
    if check and proc.returncode != 0:
        raise CliError(f"command failed: {' '.join(str(x) for x in cmd)}", proc.returncode)
    return proc


def require_qemu():
    if not shutil.which("qemu-system-aarch64"):
        raise CliError("qemu-system-aarch64 required")


def make(targets, jobs=4, extra_vars=None, capture=False, check=True, extra_env=None):
    cmd = ["make", "--no-print-directory", f"-j{jobs}"]
    if extra_vars:
        cmd.extend(extra_vars)
    cmd.extend(targets)
    run_env = os.environ.copy()
    if extra_env:
        run_env.update(extra_env)
    return run(cmd, cwd=ROOT, capture=capture, check=check, env=run_env)


