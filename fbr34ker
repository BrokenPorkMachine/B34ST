def _menu_status():
    while True:
        _clear()
        _title("System Status & Diagnostics")
        _box("Choose an option", [
            (1, "Run full system diagnostics (doctor)"),
            (2, "Show version info"),
            (3, "List supported chipsets"),
            (4, "Check toolchain & dependencies"),
            (5, "Back to main menu"),
        ])
        c = _prompt("Selection", "5")
        _clear(); _title("System Status")
        if c == "1":
            _run_and_show(["doctor"])
            _wait()
        elif c == "2":
            _run_and_show(["version"])
            _wait()
        elif c == "3":
            _run_and_show(["chipsets"])
            _wait()
        elif c == "4":
            _info("Checking core dependencies...")
            for tool, hint in [
                ("clang", "Install Xcode Command Line Tools: xcode-select --install"),
                ("ld.lld", "Install LLVM: brew install llvm"),
                ("make", "Part of Xcode CLT"),
                ("qemu-system-aarch64", "Install QEMU: brew install qemu"),
                ("python3", "Install Python 3"),
            ]:
                found = shutil.which(tool)
                if found:
                    _ok(f"{tool}: {found}")
                else:
                    _warn(f"{tool}: not found — {hint}")
            try:
                import usb.core
                _ok("pyusb: available")
            except ImportError:
                _warn("pyusb: not installed — pip install pyusb")
            _wait()
        elif c in ("5", "q", ""):
            return

