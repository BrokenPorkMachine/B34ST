def cmd_delegated(args):
    mapping = {
        "deploy": ["host/fbr34kdeploy.py"],
        "recover": ["host/fbr34kdeploy.py", "reset"],
        "inspect": ["host/fbr34kdeploy.py", "inspect"],
        "evidence": ["host/fbr34kdeploy.py", "evidence"],
        "module": ["host/fbr34kctl.py"],
        "boot-image": ["host/boot_image.py"],
        "irecovery": ["host/irecovery_boot.py"],
        "bringup": ["host/hardware_bringup.py"],
        "bridge": ["host/reference_bridge.py"],
        "session": ["host/session_tools.py"],
        "crash": ["host/session_tools.py", "crash-decode"],
        "trace": ["host/session_tools.py", "trace-timeline"],
        "hardware": ["host/hardware_workflow.py"],
        "physical-validation": ["host/physical_validation.py"],
        "abi-check": ["scripts/abi_check.py"],
        "verify-release": ["scripts/release_verify.py"],
        "compare-releases": ["scripts/compare_releases.py"],
        "evidence-compare": ["host/evidence_compare.py"],
        "ipsw": ["host/ipsw_manager.py"],
        "device-dashboard": ["host/device_dashboard.py"],
    }
    cmd = args.command
    extra = getattr(args, "arguments", [])

    script = mapping.get(cmd)
    if script is None:
        raise CliError(f"unknown command: {cmd}")
    argv = [sys.executable, str(ROOT / script[0])] + extra
    result = run(argv, check=False)
    return result.returncode


