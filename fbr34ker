def cmd_doctor(args):
    j = args.json
    issues = []
    checks = {}

    def note(kind, msg):
        issues.append((kind, msg))

    # pyusb
    try:
        import usb.core
        checks["pyusb"] = True
    except ImportError:
        checks["pyusb"] = False
        note("MISSING", "pyusb — pip install pyusb")

    # libusb
    if shutil.which("brew"):
        r = subprocess.run(["brew", "list", "libusb"], capture_output=True, text=True)
        checks["libusb"] = r.returncode == 0
        if not checks["libusb"]:
            note("MISSING", "libusb — brew install libusb")
    else:
        checks["libusb"] = None

    # toolchain
    def _find(name):
        result = shutil.which(name)
        if result is None:
            extra = ["/opt/homebrew/opt/llvm/bin", "/usr/local/opt/llvm/bin",
                     "/usr/lib/llvm-*/bin"]
            for d in extra:
                p = pathlib.Path(d.replace("*", "")) / name
                if p.expanduser().exists():
                    return str(p)
                for g in sorted(pathlib.Path(d.rsplit("/", 1)[0]).glob(d.rsplit("/", 1)[1])) if "*" in d else []:
                    p = g / name
                    if p.exists():
                        return str(p)
        return result

    for tool in ("clang", "ld.lld", "llvm-objcopy", "qemu-system-aarch64", "make"):
        checks[tool] = _find(tool) is not None
        if not checks[tool]:
            note("MISSING", f"{tool} not found in PATH")

    # irecovery
    checks["irecovery"] = shutil.which("irecovery") is not None

    # Chipset DB
    try:
        from host.chipset_db import all_chipsets
        checks["chipset_db"] = len(all_chipsets())
    except Exception:
        checks["chipset_db"] = 0
        note("ERROR", "chipset database failed to load")

    if j:
        print(json.dumps({"version": VERSION, "checks": checks, "issues": issues}))
        return 0 if not issues else 1

    print(f"\n  {Colors.BOLD}FBR34KER Doctor — v{VERSION}{Colors.RESET}\n")
    for check, ok in checks.items():
        if ok and ok is not True:
            color, mark = Colors.GREEN, f"{ok} entries"
        elif ok:
            color, mark = Colors.GREEN, "ok"
        else:
            color, mark = Colors.RED, "MISSING"
        print(f"    [{color}{mark}{Colors.RESET}] {check}")
    if issues:
        print(f"\n  {Colors.YELLOW}Issues:{Colors.RESET}")
        for kind, msg in issues:
            print(f"    {Colors.RED}{kind}{Colors.RESET}: {msg}")
    print()
    return 0 if not issues else 1


