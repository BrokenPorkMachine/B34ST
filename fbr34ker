def _clear():
    if os.isatty(1):
        print(Colors.CLEAR, end="")

def _title(sub=""):
    cols = shutil.get_terminal_size().columns
    w = max(48, min(cols - 4, 64))
    tag = f"  v{VERSION}" if not sub else f"  {sub}"
    print(f"  {Colors.BOLD}╔{'═' * (w - 2)}╗{Colors.RESET}")
    heading = "  FBR34KER Guided Console"
    print(f"  {Colors.BOLD}║{Colors.RESET}{Colors.CYAN}{heading}{Colors.RESET}{tag.rjust(w - len(heading) - 1)}{Colors.BOLD}║{Colors.RESET}")
    subtitle = "  Build, validate, simulate, and inspect"
    print(f"  {Colors.BOLD}║{Colors.RESET}{Colors.DIM}{subtitle.ljust(w - 2)}{Colors.RESET}{Colors.BOLD}║{Colors.RESET}")
    print(f"  {Colors.BOLD}╚{'═' * (w - 2)}╝{Colors.RESET}")
    print()

def _box(title, items, width=56):
    inner = width - 4
    print(f"  {Colors.BOLD}┌─ {Colors.RESET}{title}{' ' * (inner - len(title) - 2)}┐")
    for key, label in items:
        pad = inner - len(str(key)) - len(label) - 4
        print(f"  │  {Colors.CYAN}{key}{Colors.RESET}. {label}{' ' * pad}│")
    print(f"  └{'─' * (inner)}┘")

def _prompt(label, default=""):
    p = f"  {Colors.BOLD}{label}{Colors.RESET}"
    if default:
        p += f" [{Colors.DIM}{default}{Colors.RESET}]"
    p += ": "
    try:
        return input(p).strip() or default
    except (EOFError, KeyboardInterrupt):
        return "q"

def _warn(msg):
    print(f"  {Colors.YELLOW}⚠ {msg}{Colors.RESET}")

def _ok(msg):
    print(f"  {Colors.GREEN}✓ {msg}{Colors.RESET}")

def _fail(msg):
    print(f"  {Colors.RED}✗ {msg}{Colors.RESET}")

def _info(msg):
    print(f"  {Colors.DIM}{msg}{Colors.RESET}")

def _wait():
    if os.isatty(1):
        _prompt("Press Enter to continue")

def _run_and_show(args_list, msg=""):
    """Run a command via dispatch, capturing output into a scrollable view."""
    if msg:
        print(f"\n  {Colors.BOLD}{msg}{Colors.RESET}")
        print(f"  {Colors.DIM}{'─' * 52}{Colors.RESET}")
    try:
        parser = build_parser()
        parsed = parser.parse_args(args_list)
        handler = {
            "version": cmd_version,
            "doctor": cmd_doctor,
            "build": cmd_build,
            "test": cmd_test,
            "clean": cmd_clean,
            "run": cmd_run,
            "chipsets": cmd_chipsets,
            "detect": cmd_detect,
            "exploit": cmd_exploit,
            "device": cmd_device,
            "package": cmd_package,
            "gate": cmd_gate,
            "permissions": cmd_permissions,
        }.get(parsed.command, cmd_delegated)
        rc = handler(parsed)
        print(f"  {Colors.DIM}{'─' * 52}{Colors.RESET}")
        if rc == 0:
            _ok("Done")
        else:
            _fail(f"Exit code {rc}")
        return rc
    except SystemExit as e:
        rc = e.code if e.code is not None else 0
        if rc:
            _fail(f"Exit code {rc}")
        return rc
    except Exception as e:
        _fail(str(e))
        return 1

def _run_make_and_show(targets, msg="", jobs=None):
    """Run one or more Make targets with the menu's consistent result view."""
    if msg:
        print(f"\n  {Colors.BOLD}{msg}{Colors.RESET}")
        print(f"  {Colors.DIM}{'─' * 52}{Colors.RESET}")
    try:
        rc = make(targets, jobs=jobs or 4, check=False).returncode
    except Exception as e:
        _fail(str(e))
        return 1
    print(f"  {Colors.DIM}{'─' * 52}{Colors.RESET}")
    if rc == 0:
        _ok("Done")
    else:
        _fail(f"Exit code {rc}")
    return rc

def _confirm(msg):
    a = _prompt(f"{msg} (y/N)")
    return a.lower() in ("y", "yes")

def _wait_key():
    """Wait for a single keypress."""
    try:
        import tty, termios
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        try:
            tty.setraw(fd)
            ch = sys.stdin.read(1)
        finally:
            termios.tcsetattr(fd, termios.TCSADRAIN, old)
        return ch
    except (ImportError, OSError, AttributeError):
        return _prompt("Press any key (then Enter)")

