def cmd_exploit(args):
    try:
        from scripts.run_exploit import BootChain, build_operational, ExploitError
    except ImportError:
        sys.path.insert(0, str(ROOT / "scripts"))
        from run_exploit import BootChain, build_operational, ExploitError

    monitor = args.monitor
    if monitor is None:
        monitor = build_operational()
    elif not os.path.isfile(monitor):
        monitor = str(ROOT / monitor)
        if not os.path.isfile(monitor):
            raise CliError(f"monitor image not found: {monitor}")

    print(f"\n  {Colors.BOLD}FBR34KER USBliter8 Exploit Chain v{VERSION}{Colors.RESET}")
    print(f"  {Colors.DIM}A12+ DFU → DWC3 exploit → FBR34KER boot → jailbreak → boot kernel{Colors.RESET}\n")

    with BootChain(
        monitor_path=monitor,
        kernel_path=args.kernel,
        device_serial=args.ecid,
        timeout=args.timeout,
    ) as chain:
        results = chain.run_all()

        print(f"\n  {Colors.BOLD}Chain Results{Colors.RESET}")
        for step, result in results.items():
            if step == "chipset_detected":
                continue
            mark = f"{Colors.GREEN}PASS{Colors.RESET}" if result else f"{Colors.RED}FAIL{Colors.RESET}"
            name = step.replace("_", " ").title()
            print(f"    {mark}  {name}")
        if results.get("chipset_detected"):
            print(f"             Chipset: {chain.dev.chipset_name}")

        if args.evidence:
            ev_data = {
                "version": VERSION,
                "command": "exploit",
                "monitor": monitor,
                "kernel": args.kernel,
                "chipset": chain.dev.chipset,
                "results": {k: bool(v) for k, v in results.items()},
            }
            ev_path = pathlib.Path(args.evidence)
            ev_path.parent.mkdir(parents=True, exist_ok=True)
            ev_path.write_text(json.dumps(ev_data, indent=2))
            print(f"\n    Evidence: {ev_path}")

        all_pass = all(v for k, v in results.items() if k != "chipset_detected")
        return 0 if all_pass else 1


def cmd_pwndfu(args):
    try:
        from usb_serial import USBDevice
    except ImportError:
        raise CliError("pyusb not available")
    j = args.json
    dev = USBDevice(serial=args.ecid)
    if not dev.wait_for_device(timeout=args.timeout):
        if j:
            print(json.dumps({"ok": False, "error": "device not found"}))
        else:
            eprint(f"{Colors.RED}Device not found{Colors.RESET}")
        return 1
    ci = dev.chipset
    label = f" for {ci['name']} ({ci['model']})" if ci else ""
    if not j:
        print(f"  Sending DWC3 exploit{label}...")
    ok = dev.enter_pwndfu()
    if j:
        print(json.dumps({"ok": ok, "chipset": ci}))
    elif ok:
        print(f"  {Colors.GREEN}DWC3 exploited — vendor requests active on EP0{Colors.RESET}")
    else:
        eprint(f"  {Colors.RED}Exploit failed{Colors.RESET}")
    dev.close()
    return 0 if ok else 1


def cmd_load_monitor(args):
    try:
        from usb_serial import USBDevice
    except ImportError:
        raise CliError("pyusb not available")
    dev = USBDevice(serial=args.ecid)
    dev.pwned = True
    dev._claim()
    ok = dev.send_payload(args.path)
    if ok:
        size = os.path.getsize(args.path)
        print(f"  {Colors.GREEN}Monitor loaded ({size} bytes){Colors.RESET}")
    else:
        eprint(f"  {Colors.RED}Failed to load monitor{Colors.RESET}")
        return 1
    dev.close()
    return 0 if ok else 1


def cmd_console(args):
    try:
        from usb_serial import USBConsole
    except ImportError:
        raise CliError("pyusb not available")
    dev = USBConsole(serial=args.ecid)
    dev.open()
    print(f"  {Colors.GREEN}Console connected (PID 0x1227){Colors.RESET}")
    print(f"  {Colors.DIM}Type commands, Ctrl-D to exit, Ctrl-C to interrupt{Colors.RESET}")
    transcript = None
    if args.log:
        log_path = pathlib.Path(args.log)
        if not log_path.is_absolute():
            log_path = ROOT / log_path
        log_path.parent.mkdir(parents=True, exist_ok=True)
        transcript = log_path.open("a", encoding="utf-8")

    def emit(text, *, end="\n"):
        print(text, end=end)
        if transcript is not None:
            transcript.write(text + end)
            transcript.flush()

    try:
        banner = dev.read_until_prompt(timeout=5.0)
        emit(banner, end="")
        if args.command:
            if transcript is not None:
                transcript.write(f"> {args.command}\n")
            output = dev.run_command(args.command, timeout=args.timeout)
            emit(output)
        else:
            while True:
                try:
                    line = input("fbr34ker> ")
                except (EOFError, KeyboardInterrupt):
                    break
                if line.strip():
                    if transcript is not None:
                        transcript.write(f"> {line}\n")
                    output = dev.run_command(line, timeout=args.timeout)
                    emit(output, end="")
    finally:
        dev.close()
        if transcript is not None:
            transcript.close()
    return 0


