def build_parser():
    p = argparse.ArgumentParser(
        prog="fbr34ker",
        description=__doc__.split("\n")[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            Long flags:   --build       --run       --clean      --package
                          --permissions --doctor    --gate       --menu
            Short flags:  -V (version)  -D (doctor)   -b (build)   -t (test)
                          -c (clean)    -e (exploit)  -d (device)  -r (run)
                          -S (chipsets)
        """),
    )
    p.add_argument("--json", action="store_true", help="JSON output")
    p.add_argument("--version", action="version", version=f"FBR34KER {VERSION}",
                   help="show version and exit")

    sub = p.add_subparsers(dest="command", required=True)

    # core
    sub.add_parser("version")
    sub.add_parser("doctor")
    sub.add_parser("clean")
    sub.add_parser("chipsets")
    sub.add_parser("package")
    sub.add_parser("gate")
    sub.add_parser("permissions")

    bp = sub.add_parser("build")
    bp.add_argument("--jobs", type=int, default=int(os.environ.get("FBR34KER_JOBS", "4")))
    bp.add_argument("--security-model", action="store_true", default=None,
                    help="Build with FBR34KER_ENABLE_SECURITY_MODEL=1 (memory writes enabled)")
    bp.add_argument("--no-security-model", action="store_false", dest="security_model",
                    help="Build with security model disabled (state model only)")

    tp = sub.add_parser("test")
    tp.add_argument("--qemu", action="store_true")
    tp.add_argument("--jobs", type=int, default=4)

    rp = sub.add_parser("run")
    rp.add_argument("profile", choices=["direct", "generic", "probe"], nargs="?", default="direct")

    # device / exploit
    ep = sub.add_parser("exploit")
    ep.add_argument("--monitor", help="path to FBR34KER monitor binary")
    ep.add_argument("--kernel", help="path to iOS kernel")
    ep.add_argument("--ecid", help="device serial/ECID")
    ep.add_argument("--timeout", type=float, default=30.0)
    ep.add_argument("--evidence", help="write evidence JSON to path")
    ep.add_argument("--auto", action="store_true", help="auto-build monitor")

    pp = sub.add_parser("pwndfu")
    pp.add_argument("--ecid")
    pp.add_argument("--timeout", type=float, default=30.0)

    lp = sub.add_parser("load-monitor")
    lp.add_argument("path", help="path to FBR34KER monitor binary")
    lp.add_argument("--ecid")

    cp = sub.add_parser("console")
    cp.add_argument("--ecid")
    cp.add_argument("--command", "-c", help="run a single command and exit")
    cp.add_argument("--timeout", type=float, default=10.0)
    cp.add_argument("--log", help="append console input/output to this file")

    sub.add_parser("device")
    sub.add_parser("detect")

    sub.add_parser("menu")
    sub.add_parser("interactive")
    sub.add_parser("control-panel")
    b34stool_parser = sub.add_parser("b34stool")
    b34stool_parser.add_argument("arguments", nargs=argparse.REMAINDER)
    b34st_parser = sub.add_parser("b34st")
    b34st_parser.add_argument("arguments", nargs=argparse.REMAINDER)
    runtime_parser = sub.add_parser("research-runtime")
    runtime_parser.add_argument("arguments", nargs=argparse.REMAINDER)
    sub.add_parser("help")  # alias for --help

    # delegated with passthrough args
    for name in ("deploy", "recover", "module", "boot-image", "irecovery",
                 "bringup", "bridge", "session", "crash", "trace",
                 "hardware", "physical-validation", "evidence", "inspect",
                 "abi-check", "verify-release", "compare-releases",
                 "evidence-compare", "ipsw", "device-dashboard"):
        x = sub.add_parser(name)
        x.add_argument("arguments", nargs=argparse.REMAINDER)

    return p


def main(argv=None):
    raw = list(sys.argv[1:] if argv is None else argv)

    # A root-level invocation is the interactive entry point. Existing
    # subcommands remain available for scripts and automation.
    if not raw:
        raw = ["control-panel"]

    # B34ST owns its argument grammar; pass everything after the command
    # through without asking the FBR34KER parser to interpret it.
    if raw[0] == "b34stool":
        import b34stool
        return b34stool.main(raw[1:])
    if raw[0] == "b34st":
        from b34st.engine import B34STCLI
        return B34STCLI().run(raw[1:])
    if raw[0] == "research-runtime":
        from b34st.research_runtime import main as research_runtime_main
        return research_runtime_main(raw[1:])
    if raw[0] == "ipsw":
        from host.ipsw_manager import main as ipsw_main
        return ipsw_main(raw[1:])
    if raw[0] == "device-dashboard":
        from host.device_dashboard import main as device_dashboard_main
        return device_dashboard_main(raw[1:])

    # Legacy flag aliases (before argparse)
    legacy = {
        "--menu": ["menu"],
        "--doctor": ["doctor"],
        "-b": ["build"],
        "--build": ["build"],
        "--verify": ["test"],
        "--gate": ["gate"],
        "--package": ["package"],
        "-c": ["clean"],
        "--clean": ["clean"],
        "--permissions": ["permissions"],
        "-r": ["run", "direct"],
        "--run": ["run", "direct"],
        "--run-generic": ["run", "generic"],
        "--run-probe": ["run", "probe"],
        "--deployment-sim": ["deploy", "--simulator"],
    }
    if len(raw) == 1 and raw[0] in legacy:
        raw = legacy[raw[0]]

    # Short flags (before argparse)
    short = {
        "-V": ["version"], "-D": ["doctor"], "-b": ["build"],
        "-t": ["test"], "-c": ["clean"], "-e": ["exploit", "--auto"],
        "-d": ["device"], "-S": ["chipsets"],
    }
    if len(raw) == 1 and raw[0] in short:
        raw = short[raw[0]]

    # Unknown flag check (before argparse for "unknown option" wording)
    if raw and raw[0].startswith("-") and raw[0] not in ("--json", "-h", "--help", "--version"):
        eprint(f"error: unknown option {raw[0]}")
        return 2

    args = build_parser().parse_args(raw)
    cmd = args.command

    try:
        dispatch = {
            "version": cmd_version,
            "doctor": cmd_doctor,
            "build": cmd_build,
            "test": cmd_test,
            "clean": cmd_clean,
            "run": cmd_run,
            "chipsets": cmd_chipsets,
            "detect": cmd_detect,
            "exploit": cmd_exploit,
            "pwndfu": cmd_pwndfu,
            "load-monitor": cmd_load_monitor,
            "console": cmd_console,
            "device": cmd_device,
            "control-panel": cmd_control_panel,
            "b34stool": cmd_b34stool,
            "b34st": cmd_b34st,
            "package": cmd_package,
            "gate": cmd_gate,
            "permissions": cmd_permissions,
            "menu": cmd_menu,
            "interactive": cmd_menu,
            "help": lambda a: build_parser().print_help() or 0,
        }
        handler = dispatch.get(cmd, cmd_delegated)
        return handler(args)
    except CliError as e:
        if args.json:
            print(json.dumps({"ok": False, "exit_code": e.code, "error": str(e)}))
        else:
            eprint(f"{Colors.RED}error: {e}{Colors.RESET}")
        return e.code
    except KeyboardInterrupt:
        eprint("\nInterrupted")
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
