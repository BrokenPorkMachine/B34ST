{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forensics Acquisition Session v1",
  "description": "Schema for B34ST forensics acquisition session summary and evidence bundle",
  "type": "object",
  "required": ["schema", "started_at", "target", "profile", "results", "summary"],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["acquisition-session-v1"],
      "description": "Schema identifier for the acquisition session format"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of when the acquisition session started"
    },
    "target": {
      "type": "object",
      "description": "Target device information",
      "required": ["device_id"],
      "properties": {
        "device_id": { "type": "string", "description": "Unique device identifier" },
        "product": { "type": "string", "description": "Apple product type identifier" },
        "model": { "type": "string", "description": "Hardware model identifier" },
        "ios_version": { "type": "string", "description": "iOS version running on target" },
        "ecid": { "type": "string", "description": "Exclusive Chip ID" },
        "chipset": { "type": "string", "description": "SoC chipset identifier" },
        "mode": { "type": "string", "description": "Device mode (DFU, recovery, normal)" },
        "operator": { "type": "string", "description": "Name of the operator performing acquisition" }
      }
    },
    "profile": {
      "type": "object",
      "description": "Acquisition profile used",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "categories": {
          "type": "array",
          "items": { "type": "string", "enum": ["memory", "storage", "filesystem", "network", "secrets", "keybags", "keychain", "icloud", "activation", "baseband", "fmi", "passcode"] }
        }
      }
    },
    "results": {
      "type": "array",
      "description": "Results of each acquisition operation",
      "items": {
        "type": "object",
        "required": ["acquirer", "status"],
        "properties": {
          "acquirer": { "type": "string", "description": "Acquisition module name" },
          "status": { "type": "string", "enum": ["pending", "completed", "failed", "skipped"] },
          "total_bytes": { "type": "integer", "minimum": 0 },
          "file_count": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "error": { "type": "string" }
        }
      }
    },
    "summary": {
      "type": "object",
      "description": "Aggregate acquisition summary",
      "required": ["total_operations", "passed", "failed", "total_bytes"],
      "properties": {
        "total_operations": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "total_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "custody_hash": {
      "type": "string",
      "description": "SHA-256 hash of the final chain-of-custody entry",
      "pattern": "^[a-f0-9]{64}$"
    },
    "custody_verified": {
      "type": "boolean",
      "description": "Whether the chain-of-custody log passes verification"
    }
  }
}
