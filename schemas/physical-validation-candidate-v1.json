{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fbr34ker.invalid/schemas/physical-validation-candidate-v1.json",
  "title": "FBR34KER physical validation candidate report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "release_version", "release_name", "candidate_ready", "physical_validation_complete", "proof", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"const": "FBR34KER"},
    "release_version": {"type": "string"},
    "release_name": {"const": "Beta"},
    "candidate_ready": {"type": "boolean"},
    "physical_validation_complete": {"type": "boolean"},
    "proof": {
      "type": "object",
      "required": ["bridge_console", "failure_observed", "authorization_invalidated_after_reset", "recovered_after_reauthorization", "qemu_runtime", "physical_runtime"],
      "additionalProperties": {"type": "boolean"}
    },
    "success": {"type": "object"},
    "recovered": {"type": "object"},
    "qemu": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
