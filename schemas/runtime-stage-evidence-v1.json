{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fbr34ker.invalid/schemas/runtime-stage-evidence-v1.json",
  "title": "B34ST runtime stage evidence v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "stage",
    "status",
    "target",
    "observations",
    "producer"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {
      "enum": [
        "KERNEL_PATCH_ATTEMPTED",
        "KERNEL_PATCH_VERIFIED",
        "CODE_SIGNING_POLICY_VERIFIED",
        "TRUST_CACHE_ACCEPTED",
        "WRITABLE_RESEARCH_ENVIRONMENT",
        "BOOTSTRAP_ACTIVE",
        "USERSPACE_SHELL_RESPONDING"
      ]
    },
    "status": {"const": "verified"},
    "target": {
      "type": "object",
      "required": ["kernelcache_sha256"],
      "properties": {
        "kernelcache_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "rollback": {
      "type": "object",
      "properties": {
        "available": {"type": "boolean"},
        "evidence": {"type": "string"}
      }
    },
    "producer": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
